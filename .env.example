DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/pyqdb
REDIS_URL=redis://redis:6379
JWT_SECRET_KEY=your_jwt_secret
OPENROUTER_API_KEY=your_openrouter_key
BETTER_AUTH_SECRET=your_auth_secret
GOOGLE_CLIENT_ID=your_google_id
GOOGLE_CLIENT_SECRET=your_google_secret

# Object storage (AWS S3 / any S3-compatible provider).
# These env names are kept as SPACES_* for backwards compatibility, but the
# values should now point at your AWS S3 bucket.
# For AWS S3: SPACES_ENDPOINT=https://s3.<region>.amazonaws.com
SPACES_ENDPOINT=https://s3.us-east-1.amazonaws.com
SPACES_KEY=your_aws_access_key_id
SPACES_SECRET=your_aws_secret_access_key
SPACES_BUCKET=your_bucket_name
SPACES_REGION=us-east-1
# Virtual-hosted public URL, e.g. https://<bucket>.s3.<region>.amazonaws.com
SPACES_PUBLIC_URL=https://your_bucket_name.s3.us-east-1.amazonaws.com

MAX_OCR_PAGES=12
MAX_FILE_SIZE_MB=20

# Frontend
VITE_API_URL=http://127.0.0.1:8001/api
VITE_EXAMPLE_PDF_URL=
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=pyqdb

# PostHog
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
